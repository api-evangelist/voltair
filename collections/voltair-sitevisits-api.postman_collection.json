        {
          "id": "f60de39b-23d6-43ab-9439-e39626cc5453",
          "name": "List site visits for a mission",
          "request": {
            "name": "List site visits for a mission",
            "description": {
              "content": "Returns site visits for the given mission. When `compress=true`, returns\na mixed array of the highest-level ClusterVisit and unclustered SiteVisit\nobjects instead of the paginated list. Each item in the compressed\nresponse includes a `type` discriminator field (`\"clusterVisit\"` or\n`\"siteVisit\"`).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "site-visits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "missionId",
                  "value": "<uuid>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "compress",
                  "value": "<boolean>",
                  "description": "When true, returns a compressed representation: a mixed array of the highest-level ClusterVisit objects (whose parent cluster has no ClusterVisit in this mission) and unclustered SiteVisit objects. Pagination parameters are ignored when compress=true.\n"
                },
                {
                  "disabled": false,
                  "key": "unclustered",
                  "value": "<boolean>",
                  "description": "When true, returns only visits where clusterVisitId is null"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Comma-separated statuses"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Page size (default 50, max 200)"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque pagination cursor from a previous response"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
