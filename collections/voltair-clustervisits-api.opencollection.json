              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size (default 50, max 200)"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque pagination cursor from a previous response"
              }
            ]
          },
          "docs": "List cluster visits for a mission"
        },
        {
          "info": {
            "name": "Get cluster visit",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/cluster-visits/:clusterVisitId",
            "params": [
              {
                "name": "clusterVisitId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get cluster visit"
        }
      ]
    }
  ],
  "bundled": true
}