{
  "opencollection": "1.0.0",
  "info": {
    "name": "Voltair ApiKeys Events API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/events",
            "params": [
              {
                "name": "resourceType",
                "value": "",
                "type": "query",
                "description": "Comma-separated resource types"
              },
              {
                "name": "resourceId",
                "value": "",
                "type": "query"
              },
              {
                "name": "action",
                "value": "",
                "type": "query",
                "description": "Comma-separated actions (create, update, delete)"
              },
              {
                "name": "actorId",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Unix timestamp in milliseconds — events after this time"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Unix timestamp in milliseconds — events before this time"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size (default 50, max 200)"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque pagination cursor from a previous response"
              }
            ]
          },
          "docs": "List events"
        },
        {
          "info": {
            "name": "Get event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/events/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get event"
        }
      ]
    }
  ],
  "bundled": true
}